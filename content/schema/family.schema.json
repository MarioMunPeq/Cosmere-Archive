{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "family",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "color", "summary", "members"],
  "properties": {
    "id": { "$ref": "common#/$defs/id" },
    "name": { "$ref": "common#/$defs/nonEmptyString" },
    "color": { "$ref": "common#/$defs/hexColor" },
    "summary": { "$ref": "common#/$defs/summary" },
    "rootIds": { "$ref": "common#/$defs/idArray" },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "isDeceased"],
        "properties": {
          "id": { "$ref": "common#/$defs/id" },
          "name": { "$ref": "common#/$defs/nonEmptyString" },
          "character": {
            "anyOf": [{ "$ref": "common#/$defs/id" }, { "type": "null" }]
          },
          "spouse": { "anyOf": [{ "$ref": "common#/$defs/id" }, { "type": "null" }] },
          "parents": { "$ref": "common#/$defs/idArray" },
          "isDeceased": { "type": "boolean" },
          "gender": { "enum": ["male", "female", "other", null] }
        }
      }
    }
  }
}
